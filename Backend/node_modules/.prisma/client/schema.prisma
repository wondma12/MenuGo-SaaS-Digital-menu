generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model categories {
  id            String       @id @default(uuid()) @db.Uuid
  restaurant_id String       @db.Uuid
  name          String       @db.VarChar(255)
  display_order Int?         @default(0)
  created_by    String?      @db.Uuid
  created_at    DateTime     @default(now()) @db.Timestamp(0)
  updated_at    DateTime     @default(now()) @db.Timestamp(0)
  users         users?       @relation(fields: [created_by], references: [id], onUpdate: Restrict)
  restaurants   restaurants  @relation(fields: [restaurant_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  menu_items    menu_items[]

  @@index([created_by], map: "fk_category_creator")
  @@index([restaurant_id], map: "fk_category_restaurant")
}

model feedbacks {
  id            String      @id @default(uuid()) @db.Uuid
  restaurant_id String      @db.Uuid
  customer_name String?     @db.VarChar(255)
  rating        Int?
  comment       String?     @db.Text
  created_at    DateTime    @default(now()) @db.Timestamp(0)
  restaurants   restaurants @relation(fields: [restaurant_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([restaurant_id], map: "fk_feedback_restaurant")
}

model menu_items {
  id               String             @id @default(uuid()) @db.Uuid
  category_id      String             @db.Uuid
  name             String             @db.VarChar(255)
  description      String?            @db.Text
  price            Decimal            @db.Decimal(10, 2)
  image            String?            @db.VarChar(500)
  status           menu_items_status? @default(available)
  preparation_time Int?
  is_featured      Boolean?           @default(false)
  created_by       String?            @db.Uuid
  created_at       DateTime           @default(now()) @db.Timestamp(0)
  updated_at       DateTime           @default(now()) @db.Timestamp(0)
  categories       categories         @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  users            users?             @relation(fields: [created_by], references: [id], onUpdate: Restrict)
  order_items      order_items[]

  @@index([category_id], map: "fk_menu_category")
  @@index([created_by], map: "fk_menu_creator")
}

model order_items {
  id           String     @id @default(uuid()) @db.Uuid
  order_id     String     @db.Uuid
  menu_item_id String     @db.Uuid
  item_name    String?    @db.VarChar(255)
  item_price   Decimal?   @db.Decimal(10, 2)
  quantity     Int?       @default(1)
  created_at   DateTime   @default(now()) @db.Timestamp(0)
  menu_items   menu_items @relation(fields: [menu_item_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  orders       orders     @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([menu_item_id], map: "fk_orderitem_menu")
  @@index([order_id], map: "fk_orderitem_order")
}

model orders {
  id            String             @id @default(uuid()) @db.Uuid
  restaurant_id String             @db.Uuid
  served_by     String?            @db.Uuid
  order_number  String?            @unique(map: "order_number") @db.VarChar(100)
  table_number  String?            @db.VarChar(50)
  order_type    orders_order_type? @default(dine_in)
  status        orders_status?     @default(pending)
  customer_note String?            @db.Text
  total_price   Decimal?           @default(0.00) @db.Decimal(10, 2)
  created_at    DateTime           @default(now()) @db.Timestamp(0)
  updated_at    DateTime           @default(now()) @db.Timestamp(0)
  order_items   order_items[]
  restaurants   restaurants        @relation(fields: [restaurant_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  users         users?             @relation(fields: [served_by], references: [id], onUpdate: Restrict)

  @@index([restaurant_id], map: "fk_order_restaurant")
  @@index([served_by], map: "fk_order_waiter")
}

model qr_codes {
  id            String      @id @default(uuid()) @db.Uuid
  restaurant_id String      @db.Uuid
  qr_identifier String?     @unique(map: "qr_identifier") @db.VarChar(255)
  qr_image_url  String?     @db.Text
  qr_type       String?     @db.VarChar(100)
  is_active     Boolean?    @default(true)
  scan_count    Int?        @default(0)
  created_at    DateTime    @default(now()) @db.Timestamp(0)
  updated_at    DateTime    @default(now()) @db.Timestamp(0)
  restaurants   restaurants @relation(fields: [restaurant_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([restaurant_id], map: "fk_qr_restaurant")
}

model restaurant_location {
  id             String      @id @default(uuid()) @db.Uuid
  restaurant_id  String      @db.Uuid
  country        String?     @db.VarChar(100)
  city           String?     @db.VarChar(100)
  sub_city       String?     @db.VarChar(100)
  street_address String?     @db.VarChar(255)
  map_link       String      @db.VarChar(500)
  latitude       Decimal?    @db.Decimal(10, 8)
  longitude      Decimal?    @db.Decimal(11, 8)
  created_at     DateTime    @default(now()) @db.Timestamp(0)
  updated_at     DateTime    @default(now()) @db.Timestamp(0)
  restaurants    restaurants @relation(fields: [restaurant_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([restaurant_id], map: "fk_location_restaurant")
}

model restaurant_verification {
  id                        String                                       @id @default(uuid()) @db.Uuid
  restaurant_id             String                                       @db.Uuid
  owner_name                String?                                      @db.VarChar(255)
  business_license_number   String?                                      @db.VarChar(255)
  tin_number                String?                                      @db.VarChar(255)
  business_license_document String?                                      @db.VarChar(500)
  legal_document            String?                                      @db.VarChar(500)
  verification_status       restaurant_verification_verification_status? @default(pending)
  reviewed_by               String?                                      @db.Uuid
  reviewed_at               DateTime?                                    @db.Timestamp(0)
  created_at                DateTime                                     @default(now()) @db.Timestamp(0)
  updated_at                DateTime                                     @default(now()) @db.Timestamp(0)
  restaurants               restaurants                                  @relation(fields: [restaurant_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  users                     users?                                       @relation(fields: [reviewed_by], references: [id], onUpdate: Restrict)

  @@index([restaurant_id], map: "fk_verification_restaurant")
  @@index([reviewed_by], map: "fk_verification_reviewer")
}

model restaurants {
  id                                     String                    @id @default(uuid()) @db.Uuid
  owner_id                               String                    @db.Uuid
  name                                   String                    @db.VarChar(255)
  email                                  String?                   @db.VarChar(255)
  phone                                  String?                   @db.VarChar(50)
  logo                                   String?                   @db.VarChar(500)
  banner                                 String?                   @db.VarChar(500)
  slogan                                 String?                   @db.VarChar(255)
  description                            String?                   @db.Text
  website_url                            String?                   @db.VarChar(500)
  qr_code                                String?                   @db.VarChar(500)
  subscription_plan                      String?                   @db.VarChar(100)
  subscription_start                     DateTime?                 @db.Date
  subscription_end                       DateTime?                 @db.Date
  status                                 restaurants_status?       @default(pending)
  created_at                             DateTime                  @default(now()) @db.Timestamp(0)
  updated_at                             DateTime                  @default(now()) @db.Timestamp(0)
  categories                             categories[]
  feedbacks                              feedbacks[]
  orders                                 orders[]
  qr_codes                               qr_codes[]
  restaurant_location                    restaurant_location[]
  restaurant_verification                restaurant_verification[]
  users_restaurants_owner_idTousers      users                     @relation("restaurants_owner_idTousers", fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  users_users_restaurant_idTorestaurants users[]                   @relation("users_restaurant_idTorestaurants")

  @@index([owner_id], map: "fk_restaurant_owner")
}

model settings {
  id                             String   @id @default(uuid()) @db.Uuid
  platform_name                  String   @db.VarChar(255)
  support_email                  String?  @db.VarChar(255)
  contact_phone                  String?  @db.VarChar(50)
  allow_self_registration        Boolean? @default(true)
  require_verification_documents Boolean? @default(true)
  minimum_password_length        Int?     @default(8)
  session_timeout                Int?     @default(30)
  created_at                     DateTime @default(now()) @db.Timestamp(0)
  updated_at                     DateTime @default(now()) @db.Timestamp(0)
}

model users {
  id                                           String                    @id @default(uuid()) @db.Uuid
  restaurant_id                                String?                   @db.Uuid
  name                                         String                    @db.VarChar(255)
  email                                        String                    @unique(map: "email") @db.VarChar(255)
  phone                                        String?                   @db.VarChar(50)
  password                                     String                    @db.VarChar(255)
  role                                         users_role
  profile_image                                String?                   @db.VarChar(500)
  is_active                                    Boolean?                  @default(true)
  is_email_verified                            Boolean?                  @default(false)
  reset_password_token                         String?                   @db.VarChar(255)
  reset_password_expires                       DateTime?                 @db.Timestamp(0)
  last_login                                   DateTime?                 @db.Timestamp(0)
  created_at                                   DateTime                  @default(now()) @db.Timestamp(0)
  updated_at                                   DateTime                  @default(now()) @db.Timestamp(0)
  categories                                   categories[]
  menu_items                                   menu_items[]
  orders                                       orders[]
  restaurant_verification                      restaurant_verification[]
  restaurants_restaurants_owner_idTousers      restaurants[]             @relation("restaurants_owner_idTousers")
  restaurants_users_restaurant_idTorestaurants restaurants?              @relation("users_restaurant_idTorestaurants", fields: [restaurant_id], references: [id], onUpdate: Restrict)

  @@index([restaurant_id], map: "fk_user_restaurant")
}

enum orders_order_type {
  dine_in
  takeaway
}

enum menu_items_status {
  available
  unavailable
}

enum orders_status {
  pending
  verified
  preparing
  served
}

enum users_role {
  platform_admin
  restaurant_admin
  waiter
}

enum restaurant_verification_verification_status {
  pending
  approved
  rejected
}

enum restaurants_status {
  pending
  active
  suspended
}
